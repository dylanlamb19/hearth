# Copy to .env.local. Leave the Supabase keys empty to run the demo (ember@hearth.demo only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, demo mode only: require this password for ember@hearth.demo (otherwise any password works).
NEXT_PUBLIC_DEMO_PASSWORD=
# Server-only (no NEXT_PUBLIC prefix, never sent to the browser). Needed for photo/video uploads via /api/media.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Comma-separated Supabase user ids allowed to open /admin/reports.
ADMIN_USER_IDS=
# Server-only. Long random string; Vercel Cron sends it to /api/cron/media-cleanup.
CRON_SECRET=
# Server-only. Hearth Supporter (optional, cosmetic perks). Off unless "true": no UI, routes 404.
SUPPORTER_ENABLED=
# Server-only, not used yet (payments are stubbed). Test-mode values first; live keys after a test run.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
